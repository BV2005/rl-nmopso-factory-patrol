.venv/
__pycache__/
*.pyc
.claude/
# ray-distance and route table caches (rebuilt automatically, ~13 MB and ~45 MB)
data/raytable_*.pt
data/route_*.pt
# Gazebo run folders (copied to results/flights when kept)
gazebo/nmopso_demo/run_logs/
# training snapshots (results/ckpt/<run>_itNNNN.pt) and training queue outputs
results/ckpt/*_it[0-9][0-9][0-9][0-9].pt
results/runs/*_runner.out

# local archives, scratch notes and editor / OS files
*.tgz
*.tar.gz
*.zip
.vscode/
.idea/
.DS_Store
Thumbs.db
# outputs and training configs are not tracked: the published ones are in the release results-v1
# (curl -L https://github.com/BV2005/rl-nmopso-factory-patrol/releases/download/results-v1/configs-and-results.tar.gz | tar -xz)
results/*
!results/.gitkeep
configs/
