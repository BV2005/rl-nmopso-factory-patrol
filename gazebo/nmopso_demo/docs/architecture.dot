// System architecture of the NMOPSO factory2 Voronoi patrol demo (branch nmopso-demo-factory2-voronoi).
// Render: dot -Tpng -Gdpi=150 architecture.dot -o architecture.png
digraph architecture {
  graph [label="System architecture — offline NMOPSO planning, three PX4 drones, one metrics pipeline", labelloc=t,
         fontname="DejaVu Sans", fontsize=20, rankdir=TB, nodesep=0.5, ranksep=0.55, pad=0.3];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded", color="#555555", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#555555", arrowsize=0.7];

  config  [shape=note, style="", label="Scenario configuration\nworlds/factory.sdf (Downloads/factory2) · factory_layout.m 'factory2_voronoi'\n10 obstacle boxes (+ 2 flown over) · 9 patrol lanes · 3 launch pads 1.5 m apart"];
  planner [color="#eb6834", penwidth=2, label="Offline planner  (MATLAB · Windows)\nfactory_zones.m: balanced power diagram (patrol_drone pd_zone.c), balanced on lane length\nzone tours + clearance-grid routes · zone walls as cylinders · transit layer 2.9–3.3 m\nauthors' NMOPSO.m, unmodified (MaxIt 500) · one leg per job · 72 legs on 6 workers"];
  plan    [shape=note, style="", label="patrol_paths.json\nloop waypoints · transit_in / transit_out\nzone polygons · obstacles · depart delays"];
  runner  [shape=note, style="", label="run_demo.sh\nstarts Gazebo, the agent, 3 × PX4, the recorder\nand 3 followers, then runs the check and the metrics"];
  follow  [color="#2a78d6", penwidth=2, label="Patrol followers ×3  (Python · rclpy, 20 Hz timer)\nWAIT_POSITION → ARM → TAKEOFF → TRANSIT_IN → PATROL → TRANSIT_OUT → LAND\n1 m/s carrot along the NMOPSO polyline (max lead 1.5 m)\nvertical-clearance rule: hold climbs / descents while a drone is within 2 m (≤ 30 s)\n── peer topics: /droneK/fmu/out/vehicle_local_position_v1 of the other drones"];
  check   [color="#1baf7a", penwidth=2, label="Recorder + metrics  (Python)\npatrol_recorder.py: every drone at 10 Hz → drone_states.csv · events.csv\nafter the run: check_patrol.py · metrics_summary.py → metrics_summary.csv"];
  agent   [label="MicroXRCEAgent  (uXRCE-DDS bridge, UDP 8888)"];
  px4     [label="PX4 SITL ×3  (x500, airframe 4001, namespace droneN)\noffboard position control · spawned on the launch pads"];
  gz      [label="Gazebo Sim 8 (Harmonic) — factory.sdf (factory2)\n30 × 20 m hall, 1 ms physics step"];

  config -> planner;
  planner -> plan;
  plan -> follow [label="  waypoints, homes"];
  plan -> check  [label="planned polylines,\nobstacles, pads", style=dashed];
  runner -> follow [style=dotted, arrowhead=none];
  follow -> agent [label="/droneN/fmu/in/trajectory_setpoint\noffboard_control_mode"];
  agent:ne -> follow [style=dashed, xlabel="/droneN/fmu/out/vehicle_local_position_v1\nvehicle_status_v4"];
  follow:sw -> px4:w [xlabel="pymavlink, udpin 14540+N\nset mode · arm · land · disarm  ", style=dashed, constraint=false];
  follow -> check [label="/droneN/patrol/event\ntrace_droneN.csv (20 Hz)"];
  agent -> check [style=dashed, label="all drones: vehicle_local_position_v1 · vehicle_attitude\nbattery_status_v1 · vehicle_status_v4 · vehicle_land_detected"];
  agent -> px4 [dir=both];
  px4 -> gz [dir=both];

  {rank=same; plan; runner;}
  {rank=same; follow; check;}
}
