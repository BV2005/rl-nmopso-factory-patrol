<?xml version="1.0"?>
<model>
  <name>x500_patrol</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    PX4 x500 indoor patrol drone: 2D lidar (270 deg) on a mast and a forward OAK-D Lite style
    stereo depth + RGB camera. Its sensors feed the sensor-input RL leg planner
    (rlpatrol/sensors.py, gazebo/nmopso_demo/sensor_follower.py).
  </description>
</model>
